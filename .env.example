# Backend API base URL used by Axios in the browser.
# In development (with Vite proxy), keep it as /api
# In production (separate backend host), set to your production API URL, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Proxy target for Vite dev server (only used during local development via `npm run dev`)
VITE_PROXY_TARGET=http://localhost:5000
